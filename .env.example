# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Application authentication
JWT_SECRET=replace_with_a_strong_random_secret

# Wallet encryption (required)
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_exactly_64_hexadecimal_characters

# Polygon Amoy / ChronosToken / ReservationEscrow
RPC_URL=https://rpc-amoy.polygon.technology
ADMIN_PRIVATE_KEY=replace_with_the_operator_wallet_private_key
# Alias accepted by EscrowService (optional if ADMIN_PRIVATE_KEY is set)
PRIVATE_KEY=
CHRONOS_TOKEN_ADDRESS=replace_after_chronos_token_deployment
ESCROW_ADDRESS=replace_after_reservation_escrow_deployment
# Whole CHRONOS locked per booking (default 20)
ESCROW_DEPOSIT_AMOUNT=20

# If student POL < threshold, admin sends GAS_TOPUP_AMOUNT before approve
GAS_TOPUP_ENABLED=true
GAS_TOPUP_THRESHOLD=0.005
GAS_TOPUP_AMOUNT=0.01

# Optional integrations already used by the backend
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# AI & Vector DB Integration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=chronos-manuals
HUGGINGFACE_TOKEN=your_huggingface_token_here
OPENAI_API_KEY=your_openai_api_key_here
